@model IEnumerable<Hearty_Bites.Models.CartItem>

<div class="container mt-5 mb-5">
    <h2 class="premium-font mb-4" style="color: #7A2836;"><i class="bi bi-cart3 me-2"></i>Your Cart</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center p-5 shadow-sm" style="background-color: #F9F6F0; border-radius: 16px;">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3 premium-font" style="color: #8C7361;">Your cart is empty.</h4>
            <p class="text-muted">Looks like you haven't added any order yet.</p>
            <a asp-controller="Customer" asp-action="Index" class="btn mt-3 text-white rounded-pill px-4" style="background-color: #7A2836;">
                <i class="bi bi-search me-2"></i> Browse Caterers
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8 mb-4 mb-lg-0">
                <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden;">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #F9F6F0; color: #8C7361;">
                                <tr>
                                    <th class="ps-4 py-3">Menu</th>
                                    <th class="py-3">Customizations</th>
                                    <th class="py-3 text-center">Qty</th>
                                    <th class="py-3 text-end">Price</th>
                                    <th class="py-3 pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <strong style="color: #3E322C;">@item.MenuItem?.FoodName</strong><br />
                                            <small class="text-muted"><i class="bi bi-shop me-1"></i>@item.MenuItem?.Caterer?.ShopName</small>
                                        </td>
                                        <td class="py-3">
                                            <small class="text-muted">@item.CustomizationSummary</small>
                                        </td>
                                        <td class="py-3 text-center">
                                            <span class="badge bg-secondary rounded-pill">@item.Quantity</span>
                                        </td>
                                        <td class="py-3 text-end fw-bold" style="color: #3E322C;">
                                            @((item.UnitPrice * item.Quantity).ToString("C"))
                                        </td>
                                        <td class="py-3 pe-4 text-end">
                                            <form asp-action="Remove" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Remove Item">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0" style="background-color: #F9F6F0; border-radius: 16px;">
                    <div class="card-body p-4">
                        <h5 class="premium-font mb-4" style="color: #3E322C;">Order Summary</h5>
                        
                        @{
                            decimal total = Model.Sum(i => i.UnitPrice * i.Quantity);
                        }
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold text-dark">@total.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Delivery Fee</span>
                            <span class="badge bg-success rounded-pill align-self-center">Free</span>
                        </div>
                        <hr style="border-color: #E6DFD3;"/>
                        <div class="d-flex justify-content-between mb-4">
                            <strong class="fs-5" style="color: #3E322C;">Total</strong>
                            <strong class="fs-5" style="color: #7A2836;">@total.ToString("C")</strong>
                        </div>

                        <a asp-controller="Cart" asp-action="Checkout" class="btn w-100 text-white rounded-pill py-3 fw-bold shadow-sm" style="background-color: #7A2836;">
                            Proceed to Checkout <i class="bi bi-credit-card ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>