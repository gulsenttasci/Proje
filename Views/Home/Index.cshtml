@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    string mapsApiKey = Configuration["GoogleMaps:ApiKey"] ?? "";
    ViewData["Title"] = "Home Page";
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="container-fluid px-0">
        <div class="row align-items-center vh-100"
             style="background: url('/images/index/caterist-hero.png') no-repeat center center; background-size: cover; margin-top: -20px;">

            <div class="col-lg-5 text-center text-lg-start px-5 py-5 ms-lg-5 shadow-lg"
                 style="background: rgba(249, 246, 240, 0.85); backdrop-filter: blur(8px); border-radius: 24px; border: 1px solid rgba(255,255,255,0.5);">
                <h1 class="display-4 fw-bold premium-font mb-4" style="color: #3E322C;">
                    Gourmet Experiences, <br />
                    <span style="color: #7A2836;">Delivered to You.</span>
                </h1>
                <p class="lead text-muted mb-5" style="font-size: 1.1rem; line-height: 1.6;">
                    Connect with top-tier local caterers. Customize your menus dynamically, track your orders, and
                    experience premium culinary services for your special events.
                </p>
                <div class="d-flex justify-content-center justify-content-lg-start gap-3">
                    <a asp-area="Identity" asp-page="/Account/Register"
                       class="btn text-white rounded-pill px-4 py-3 fw-bold shadow"
                       style="background-color: #7A2836; font-size: 1rem;">
                        Join as Customer
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="btn btn-outline-dark rounded-pill px-4 py-3 fw-bold shadow-sm" style="font-size: 1rem;">
                        Sign In
                    </a>
                </div>

                <div class="mt-5 d-flex justify-content-center justify-content-lg-start gap-4 text-muted small">
                    <span><i class="bi bi-check-circle-fill text-success me-1"></i> Verified Caterers</span>
                    <span><i class="bi bi-shield-check text-success me-1"></i> Secure Payments</span>
                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-block">
            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5 text-center">
        <h2 class="premium-font mb-4" style="color: #3E322C;">Find Caterers Near You</h2>

        <button id="gpsButton" class="btn text-white rounded-pill px-4 py-2 mb-4 shadow-sm"
                style="background-color: #7A2836; font-size: 18px;">
            <i class="bi bi-geo-alt-fill me-2"></i> Find Caterers Near Me
        </button>

        <div id="map" class="shadow-sm d-none mx-auto mb-5"
             style="height: 450px; width: 100%; max-width: 900px; border-radius: 16px; border: 3px solid #E6DFD3;"></div>

        <div id="catererListSection" class="d-none text-start mx-auto mt-5" style="max-width: 900px;">
            <h4 class="premium-font mb-4" style="color: #3E322C;"><i class="bi bi-grid-3x3-gap-fill me-2"
                                                                         style="color: #8C7361;"></i> Available Kitchens</h4>
                <div id="catererCardsContainer" class="row g-3"></div>
            </div>
        </div>

        <script src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey&loading=async" async defer></script>

        @section Scripts {
            <script>
                document.getElementById('gpsButton').addEventListener('click', function () {
                let btn = this;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Finding your location...';

                if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                function (position) {
                initializeMapAndLoadCaterers(position.coords.latitude, position.coords.longitude, btn);
                },
                function (error) {
                initializeMapAndLoadCaterers(39.9334, 32.8597, btn);
                }
                );
                } else {
                initializeMapAndLoadCaterers(39.9334, 32.8597, btn);
                }
                });

                function initializeMapAndLoadCaterers(userLat, userLng, btn) {
                var mapDiv = document.getElementById('map');
                mapDiv.classList.remove('d-none');

                var map = new google.maps.Map(mapDiv, {
                zoom: 10,
                center: { lat: userLat, lng: userLng },
                mapTypeControl: false
                });

                new google.maps.Marker({
                position: { lat: userLat, lng: userLng },
                map: map,
                title: "You are here!"
                });

                btn.innerHTML = '<i class="bi bi-geo-alt-fill me-2"></i> Location Found';
                btn.style.backgroundColor = '#8C7361';

                const listSection = document.getElementById('catererListSection');
                const cardsContainer = document.getElementById('catererCardsContainer');

                cardsContainer.innerHTML = '';

                fetch(`/Home/GetNearbyCaterers?userLat=${userLat}&userLng=${userLng}`)
                .then(response => response.json())
                .then(data => {
                if (!data || data.length === 0) {
                return;
                }

                listSection.classList.remove('d-none');

                data.forEach(shop => {
                let shopLat = shop.latitude ?? shop.Latitude ?? 0;
                let shopLng = shop.longitude ?? shop.Longitude ?? 0;
                let shopName = shop.shopName || shop.ShopName || "Caterings";
                let shopId = shop.id !== undefined ? shop.id : shop.Id;

                let imgUrl = shop.imageUrl || shop.ImageUrl;
                let imageHtml = imgUrl
                ? `<img src="${imgUrl}" alt="${shopName}" class="shadow-sm" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px; border: 2px solid #fff;">`
                : `<div class="d-flex align-items-center justify-content-center bg-light text-muted shadow-sm" style="width: 100%; height: 100%; border-radius: 12px; border: 2px solid #fff;">
                <i class="bi bi-shop" style="font-size: 2rem;"></i>
                </div>`;

                if (Math.abs(shopLat) > 90) {
                shopLat = shopLat / 10000000;
                }
                if (Math.abs(shopLng) > 180) {
                shopLng = shopLng / 10000000;
                }

                if (shopLat === 0 || shopLng === 0) {
                return;
                }

                var shopMarker = new google.maps.Marker({
                position: { lat: parseFloat(shopLat), lng: parseFloat(shopLng) },
                map: map,
                title: shopName,
                animation: google.maps.Animation.DROP
                });

                var infoWindow = new google.maps.InfoWindow({
                content: `<div style="text-align:center; color:#3E322C; font-family:sans-serif; padding:5px;">
                <b style="font-size:14px;">${shopName}</b><br>
                <a href="/Home/ShopDetails/${shopId}" class="btn btn-sm text-white mt-2 rounded-pill" style="background-color:#7A2836; font-size:12px; padding:4px 12px; text-decoration:none; display:inline-block;">View Menu</a>
                </div>`
                });

                shopMarker.addListener('click', function () {
                infoWindow.open(map, shopMarker);
                });

                let fallbackImg = shopId % 2 === 0
                ? 'https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=300&q=80'
                : 'https://images.unsplash.com/photo-1583394838336-acd977736f90?w=300&q=80';

                let finalImgUrl = shop.imageUrl || shop.ImageUrl || fallbackImg;

                let cardHtml = `
                <div class="col-md-6">
                <div class="card border-0 shadow-sm p-3 mb-2" style="border-radius: 14px; border: 1px solid #E6DFD3 !important; background-color: #F9F6F0;">
                <div class="d-flex align-items-center gap-3">
                <div style="width: 90px; height: 90px; flex-shrink: 0;">
                ${imageHtml}
                </div>
                <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                <h5 class="fw-bold mb-1" style="color: #3E322C; font-size: 1.1rem;">${shopName}</h5>
                <small class="text-muted d-block mb-1"><i class="bi bi-shop me-1" style="color: #8C7361;"></i> Premium Kitchen</small>
                </div>
                <a href="/Home/ShopDetails/${shopId}" class="btn text-white rounded-pill px-4 py-2 btn-sm fw-bold shadow-sm" style="background-color: #7A2836; font-size: 13px;">
                View Menu
                </a>
                </div>
                </div>
                </div>
                </div>
                `;
                cardsContainer.insertAdjacentHTML('beforeend', cardHtml);
                });
                })
                .catch(err => console.error(err));
                }
            </script>
        }
    }