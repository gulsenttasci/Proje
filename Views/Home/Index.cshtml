@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    
    string mapsApiKey = Configuration["GoogleMaps:ApiKey"] ?? "";
}
@{
    ViewData["Title"] = "Home Page";
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="container-fluid px-0">
        <div class="row align-items-center vh-100" style="background: linear-gradient(135deg, #F9F6F0 0%, #E6DFD3 100%); margin-top: -20px;">
            <div class="col-lg-6 text-center text-lg-start px-5">
                <h1 class="display-3 fw-bold premium-font mb-4" style="color: #3E322C;">
                    Gourmet Experiences, <br />
                    <span style="color: #7A2836;">Delivered to You.</span>
                </h1>
                <p class="lead text-muted mb-5" style="font-size: 1.2rem; line-height: 1.6;">
                    Connect with top-tier local caterers. Customize your menus dynamically, track your orders, and experience premium culinary services for your special events.
                </p>
                <div class="d-flex justify-content-center justify-content-lg-start gap-3">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn text-white rounded-pill px-5 py-3 fw-bold shadow" style="background-color: #7A2836; font-size: 1.1rem;">
                        Join as Customer
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-dark rounded-pill px-5 py-3 fw-bold shadow-sm" style="font-size: 1.1rem;">
                        Sign In
                    </a>
                </div>
                
                <div class="mt-5 d-flex justify-content-center justify-content-lg-start gap-4 text-muted">
                    <span><i class="bi bi-check-circle-fill text-success me-2"></i> Verified Caterers</span>
                    <span><i class="bi bi-shield-check text-success me-2"></i> Secure Payments</span>
                </div>
            </div>
            
            <div class="col-lg-6 d-none d-lg-flex justify-content-center">
                <div class="position-relative">
                    <div class="rounded-circle shadow-lg d-flex align-items-center justify-content-center" style="width: 400px; height: 400px; background-color: white; border: 15px solid #8C7361;">
                        <i class="bi bi-shop text-muted" style="font-size: 150px;"></i>
                    </div>
                    <div class="position-absolute bottom-0 start-0 bg-white p-3 rounded-4 shadow" style="transform: translate(-20%, 20%);">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-star-fill text-warning fs-4 me-2"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Premium Quality</h6>
                                <small class="text-muted">Top rated partners</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5 text-center">
        <h2 class="premium-font mb-4" style="color: #3E322C;">Find Caterers Near You</h2>
        
        <button id="gpsButton" class="btn text-white rounded-pill px-4 py-2 mb-4 shadow-sm" style="background-color: #7A2836; font-size: 18px;">
            <i class="bi bi-geo-alt-fill me-2"></i> Find Caterers Near Me
        </button>

        <div id="map" class="shadow-sm d-none mx-auto" style="height: 450px; width: 100%; max-width: 900px; border-radius: 16px; border: 3px solid #E6DFD3;"></div>
    </div>

    <script src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey&loading=async" async defer></script>

    <script>
        document.getElementById('gpsButton').addEventListener('click', function () {
            if (navigator.geolocation) {
                let btn = this;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Finding your location...';
                
                navigator.geolocation.getCurrentPosition(function (position) {
                    var userLat = position.coords.latitude;
                    var userLng = position.coords.longitude;

                    var mapDiv = document.getElementById('map');
                    mapDiv.classList.remove('d-none');

                    var map = new google.maps.Map(mapDiv, {
                        zoom: 13,
                        center: { lat: userLat, lng: userLng },
                        mapTypeControl: false
                    });

                    new google.maps.Marker({
                        position: { lat: userLat, lng: userLng },
                        map: map,
                        title: "You are here!",
                        icon: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png'
                    });

                    btn.innerHTML = '<i class="bi bi-geo-alt-fill me-2"></i> Location Found';
                    btn.style.backgroundColor = '#8C7361';

                    fetch(`/Home/GetNearbyCaterers?userLat=${userLat}&userLng=${userLng}`)
                        .then(response => response.json())
                        .then(data => {
                            data.forEach(shop => {
                                if(shop.latitude && shop.longitude) {
                                    var shopMarker = new google.maps.Marker({
                                        position: { lat: shop.latitude, lng: shop.longitude },
                                        map: map,
                                        title: shop.shopName,
                                        animation: google.maps.Animation.DROP
                                    });

                                    var infoWindow = new google.maps.InfoWindow({
                                        content: `<div style="text-align:center;"><b>${shop.shopName}</b><br><a href="/Home/ShopDetails/${shop.id}" class="btn btn-sm text-white mt-2 rounded-pill" style="background-color:#7A2836; font-size:12px;">View Menu</a></div>`
                                    });

                                    shopMarker.addListener('click', function() {
                                        infoWindow.open(map, shopMarker);
                                    });
                                }
                            });
                        });

                }, function (error) {
                    alert("Location permission was denied or could not be obtained.");
                    btn.innerHTML = '<i class="bi bi-geo-alt-fill me-2"></i> Find Caterers Near Me';
                });
            } else {
                alert("Your browser does not support the GPS feature.");
            }
        });
    </script>
}