@model Hearty_Bites.Models.Caterer

@{
    ViewData["Title"] = Model.ShopName + " - Menus";
    var menus = ViewBag.Menus as List<Hearty_Bites.Models.MenuItem>;
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">

<style>
    .premium-font { font-family: 'Playfair Display', serif; color: #3E322C; }
    .food-price { color: #7A2836; font-weight: 600; font-size: 1.3rem; font-family: 'Courier New', Courier, monospace; }
    
    /* Özel Radio ve Checkbox Renkleri */
    .custom-check-input:checked {
        background-color: #7A2836;
        border-color: #7A2836;
    }
</style>

<div class="container-fluid px-0" style="margin-top: -20px;">
    <div class="p-5 text-center shadow-sm" style="background: linear-gradient(135deg, #3E322C 0%, #1A1412 100%); color: #F9F6F0;">
        <span class="badge bg-warning text-dark mb-3 fw-bold px-3 py-2 rounded-pill"><i class="bi bi-patch-check-fill me-1"></i> VERIFIED CATERER</span>
        <h1 class="premium-font display-4 fw-bold text-white mb-3">@Model.ShopName</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 600px;">@Model.Description</p>

        <div class="d-flex justify-content-center gap-4 mt-4 text-muted" style="font-size: 1rem;">
            <span><i class="bi bi-geo-alt-fill text-danger me-1"></i><span style="color: #F9F6F0 !important; font-weight: 500;">@Model.Address</span></span>
            <span style="color: rgba(249, 246, 240, 0.4) !important;">|</span>
            <span><i class="bi bi-envelope-fill text-info me-1"></i><span style="color: #F9F6F0 !important; font-weight: 500;">@Model.Email</span></span>
            @if(!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <span style="color: rgba(249, 246, 240, 0.4) !important;">|</span>
                <span><i class="bi bi-telephone-fill text-success me-1"></i><span style="color: #F9F6F0 !important; font-weight: 500;">@Model.PhoneNumber</span></span>
            }
        </div>
    </div>
</div>

<div class="container mt-5 mb-5" style="max-width: 1000px;">
    <h3 class="premium-font mb-4 text-center" style="color: #3E322C;"><i class="bi bi-journal-richtext me-2 text-muted"></i>Available Catering Packages</h3>

    @if (menus == null || !menus.Any())
    {
        <div class="alert alert-light text-center rounded-4 p-5 shadow-sm border">
            <i class="bi bi-egg-fried display-1 d-block mb-3 text-muted"></i>
            <h4 class="premium-font" style="color: #8C7361;">This caterer hasn't posted any menus yet.</h4>
            <p class="text-muted">Check back soon for delicious updates!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
            @foreach (var menu in menus)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4" style="background-color: #fff; border: 1px solid #E6DFD3 !important;">
                        @if (!string.IsNullOrEmpty(menu.ImageUrl))
                        {
                            <div style="height: 200px; overflow: hidden; border-radius: 16px 16px 0 0;">
                                <img src="@menu.ImageUrl" alt="@menu.FoodName" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                        }

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h4 class="card-title premium-font fw-bold mb-1" style="color: #3E322C;">@menu.FoodName</h4>
                                    <span class="badge rounded-pill px-3 py-1" style="background-color: #F9F6F0; color: #8C7361; border: 1px solid #E6DFD3;">
                                        <i class="bi bi-bookmark-star-fill me-1"></i> @menu.Category
                                    </span>
                                </div>
                                <div class="text-end">
                                    <span class="food-price">@menu.Price.ToString("C")</span>
                                    <small class="text-muted d-block" style="font-size: 0.8rem;">per guest</small>
                                </div>
                            </div>

                            <p class="card-text text-muted mb-4 flex-grow-1">@menu.Description</p>

                            <button type="button" class="btn text-white w-100 rounded-pill fw-bold shadow-sm py-2" style="background-color: #7A2836;" data-bs-toggle="modal" data-bs-target="#orderModal-@menu.Id">
                                Select Options & Order <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="orderModal-@menu.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content border-0" style="border-radius: 24px; overflow: hidden;">
                            <div class="modal-header py-4 px-4" style="background-color: #F9F6F0; border-bottom: 2px solid #E6DFD3;">
                                <div>
                                    <h4 class="modal-title premium-font fw-bold mb-0" style="color: #3E322C;">@menu.FoodName</h4>
                                    <small class="text-muted">Customize your event package</small>
                                </div>
                                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="menuItemId" value="@menu.Id" />
                                <input type="hidden" name="unitPrice" value="@menu.Price" />
                                <input type="hidden" name="customizationSummary" id="summary-@menu.Id" value="" />

                                <div class="modal-body p-4">
                                    @if (menu.CustomizationGroups != null && menu.CustomizationGroups.Any(g => !g.IsDeleted))
                                    {
                                        @foreach (var group in menu.CustomizationGroups.Where(g => !g.IsDeleted))
                                        {
                                            <div class="mb-4">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <h6 class="fw-bold mb-0" style="color: #8C7361;">@group.GroupName</h6>
                                                    @if (group.IsMultipleChoice)
                                                    {
                                                        <span class="badge bg-light text-muted border rounded-pill">Choose Multiple</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-danger border rounded-pill">Required (Pick 1)</span>
                                                    }
                                                </div>
                                                
                                                <div class="p-3 rounded-4" style="background-color: #fcfbf9; border: 1px solid #f0ebe1;">
                                                    @if (group.Options != null && group.Options.Any())
                                                    {
                                                        foreach (var option in group.Options.Where(o => !o.IsDeleted))
                                                        {
                                                            <div class="form-check mb-2">
                                                                <input class="form-check-input custom-check-input opt-input-@menu.Id" 
                                                                       type="@(group.IsMultipleChoice ? "checkbox" : "radio")" 
                                                                       name="Group_@group.Id" 
                                                                       value="@group.GroupName: @option.OptionName" 
                                                                       id="opt-@option.Id"
                                                                       @(group.IsMultipleChoice ? "" : "required")>
                                                                
                                                                <label class="form-check-label w-100 d-flex justify-content-between text-muted" for="opt-@option.Id">
                                                                    <span>@option.OptionName</span>
                                                                    @if(option.AdditionalPrice > 0)
                                                                    {
                                                                        <span class="text-success">+@option.AdditionalPrice.ToString("C")</span>
                                                                    }
                                                                </label>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted">
                                            <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
                                            This is a standard package with no extra customizations.
                                        </div>
                                    }

                                    <hr class="text-muted my-4" />

                                    <div>
                                        <label class="fw-bold mb-2" style="color: #3E322C;"><i class="bi bi-people-fill me-2 text-muted"></i>Number of Guests</label>
                                        <div class="input-group input-group-lg shadow-sm">
                                            <input type="number" name="quantity" class="form-control text-center fw-bold" min="10" max="1000" value="50" style="border: 2px solid #E6DFD3; color: #7A2836;" required />
                                            <span class="input-group-text bg-white text-muted" style="border: 2px solid #E6DFD3; border-left: none;">Guests</span>
                                        </div>
                                        <small class="text-muted mt-2 d-block text-center">Minimum 10 guests required for this package.</small>
                                    </div>
                                </div>

                                <div class="modal-footer px-4 py-3 border-0" style="background-color: #F9F6F0;">
                                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" onclick="compileCustomizationsModal(@menu.Id)" class="btn text-white rounded-pill px-5 fw-bold shadow-sm" style="background-color: #3E322C;">
                                        <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-5 p-4 rounded-4 shadow-sm" style="background-color: #fff; border: 1px solid #E6DFD3;">
        <h4 class="mb-4 premium-font fw-bold" style="color: #3E322C;"><i class="bi bi-chat-heart-fill me-2" style="color: #7A2836;"></i> Customer Reviews</h4>
        
        @if (ViewBag.Comments != null && ((IEnumerable<Hearty_Bites.Models.Comments>)ViewBag.Comments).Any())
        {
            <div class="row g-4">
                @foreach (var comment in (IEnumerable<Hearty_Bites.Models.Comments>)ViewBag.Comments)
                {
                    <div class="col-md-6">
                        <div class="p-4 rounded-4" style="background-color: #F9F6F0; border-left: 4px solid #8C7361;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold" style="color: #3E322C;">
                                    <i class="bi bi-person-circle text-muted me-1"></i>
                                    @(!string.IsNullOrEmpty(comment.User?.Email) ? comment.User.Email : "Verified Customer")
                                </span>
                                <small class="text-muted">@comment.CreatedDate.ToString("MMM dd, yyyy")</small>
                            </div>
                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star-fill @(i <= comment.StarRating ? "text-warning" : "text-muted opacity-25")"></i>
                                }
                            </div>
                            <p class="mb-0 text-muted fst-italic">"@comment.CommentText"</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-balloon-heart display-4 d-block mb-3 opacity-50"></i>
                <p class="mb-0">No reviews available for this kitchen yet. Be the first to try!</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        
        function compileCustomizationsModal(menuId) {
            let summaryParts = [];
            
            let selectedInputs = document.querySelectorAll(`.opt-input-${menuId}:checked`);
            
            selectedInputs.forEach(input => {
                summaryParts.push(input.value);
            });


            let finalSummary = summaryParts.join(", ");
            document.getElementById(`summary-${menuId}`).value = finalSummary;
        }
    </script>
}