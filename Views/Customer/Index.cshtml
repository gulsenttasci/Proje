@model IEnumerable<Hearty_Bites.Models.Caterer>

<div class="container mt-5 mb-5">
    <div class="p-5 mb-4 rounded-3 shadow-sm border-0" style="background-color: #F9F6F0;">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold premium-font" style="color: #3E322C;">Welcome to The Caterist!</h1>
            <p class="col-md-8 fs-4 text-muted">Discover professional caterers near you, customize your menus dynamically, and experience premium tastes tailored to your events.</p>
            <a href="#caterersList" class="btn text-white px-4 py-2 rounded-pill fw-bold" style="background-color: #7A2836;">
                <i class="bi bi-arrow-down-circle me-1"></i> Explore Caterers
            </a>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 id="caterersList"">
        <h3 class="premium-font mb-0" style="color: #8C7361;">Available Catering Partners</h3>
        <span class="badge bg-secondary rounded-pill p-2">@Model.Count() Partners Found</span>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var caterer in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 16px; transition: transform 0.2s;">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 50px; height: 50px; background-color: #8C7361; font-size: 20px;">
                                        <i class="bi bi-shop"></i>
                                    </div>
                                    <div class="ms-3">
                                        <h5 class="card-title mb-0 fw-bold premium-font" style="color: #3E322C;">@caterer.ShopName</h5>
                                        <small class="text-muted"><i class="bi bi-geo-alt-fill me-1"></i>@caterer.Address</small>
                                    </div>
                                </div>

                                <p class="card-text text-muted" style="font-size: 14px; line-height: 1.5;">
                                    @caterer.Description
                                </p>
                            </div>

                            <div class="mt-3">
                                <a asp-controller="Home" asp-action="ShopDetails" asp-route-id="@caterer.Id" class="btn text-white w-100 rounded-pill fw-bold" style="background-color: #7A2836;">
                                    View Menu & Order <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-100 text-center p-5 w-100">
                <i class="bi bi-emoji-frown display-1 text-muted"></i>
                <h4 class="mt-3 premium-font" style="color: #8C7361;">No active caterers found at the moment.</h4>
                <p class="text-muted">Please check back later.</p>
            </div>
        }
    </div>
</div>