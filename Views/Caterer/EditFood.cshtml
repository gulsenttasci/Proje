@model Hearty_Bites.Models.MenuItem

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden; background-color: #ffffff;">
                <div class="card-header bg-white py-4 text-center" style="border-bottom: 2px solid #E6DFD3;">
                    <h2 class="mb-0 premium-font fw-bold" style="color: #3E322C;">
                        <i class="bi bi-pencil-square me-2" style="color: #7A2836;"></i>Update Menu
                    </h2>
                </div>
                <div class="card-body p-5">
                    <form asp-action="EditFood" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CatererId" />
                        <input type="hidden" asp-for="ImageUrl"/>

                        <div class="mb-4">
                            <label asp-for="FoodName" class="form-label premium-font fw-bold" style="color: #8C7361;">Menu Name</label>
                            <input asp-for="FoodName" class="form-control rounded-pill px-3 py-2 shadow-none" style="border: 2px solid #E6DFD3; background-color: #F9F6F0;"/>
                            <span asp-validation-for="FoodName" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label premium-font fw-bold" style="color: #8C7361;" >Price (₺)</label>
                                <input asp-for="Price" class="form-control rounded-pill px-3 py-2 shadow-none" type="number" step="0.01" style="border: 2px solid #E6DFD3; background-color: #F9F6F0;" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6 mt-3 mt-md-0">
                                <label asp-for="Category" class="form-label premium-font fw-bold" style="color: #8C7361;">Event Concept</label>
                                <select asp-for="Category" class="form-select rounded-pill px-3 py-2 shadow-none" style="border: 2px solid #E6DFD3; background-color: #F9F6F0;" required>
                                    <option value="General">General (Standard)</option>
                                    <option value="Wedding">Wedding</option>
                                    <option value="Cocktail">Cocktail</option>
                                    <option value="Birthday">Birthday</option>
                                    <option value="Corporate">Corporate</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label premium-font fw-bold" style="color: #8C7361">Description</label>
                            <textarea asp-for="Description" class="form-control px-3 py-3 shadow-none" rows="5" style="border: 2px solid #E6DFD3; background-color: #F9F6F0; border-radius: 15px; resize: vertical; line-height: 1.6;"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-5 p-4 rounded-4 text-center" style="background-color: #F9F6F0; border: 2px dashed #E6DFD3;">
                            <label class="form-label premium-font fw-bold mb-3 d-block" style="color: #3E322C;">
                                <i class="bi bi-camera me-2" style="color: #8C7361;"></i>Update Cover Image
                            </label>
                            
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3">
                                    <img src="@Model.ImageUrl" alt="Current Image" class="img-thumbnail shadow-sm" style="max-height: 150px; border-radius: 12px; border: 2px solid #E6DFD3;" />
                                </div>
                            }

                            <input type="file" name="imageFile" class="form-control rounded-pill px-3 py-2 shadow-none bg-white" accept="image/*" />
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-info-circle me-1"></i>Leave empty to keep the current image.
                            </small>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn text-white btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #7A2836; transition: all 0.3s;">
                                Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-light rounded-pill fw-bold text-muted border shadow-sm">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>