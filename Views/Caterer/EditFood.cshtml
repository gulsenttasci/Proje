@model Hearty_Bites.Models.MenuItem

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden; background-color: #ffffff;">
                <div class="card-header bg-white py-4 text-center" style="border-bottom: 1px solid #E6DFD3;">
                    <h4 class="mb-0 premium-font"style="color: #3E322C;">
                        <i class="bi bi-pencil-square me-2" style="color: #8C7361;"></i>Update Menu
                    </h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="EditFood" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CatererId" />
                        <input type="hidden" asp-for="ImageUrl"/>

                        <div class="mb-4">
                            <label asp-for="FoodName" class="form-label premium-font fw-bold">Menu Name</label>
                            <input asp-for="FoodName" class="form-control" />
                            <span asp-asp-validation-for="FoodName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label premium-font fw-bold" style="color: #8C7361">Description</label>
                            <textarea asp-for="Description" class="form-control px-3 py-2 shadow-none" rows="3" style="border: 1px solid #E6DFD3; background-color: #F9F6F0; color:#3E322C"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Price" class="form-label premium-font fw-bold"style="color: #8C7361;" >Price</label>
                            <input asp-for="Price" class="form-control px-3 py-2 shadow-none" type="number" step="0.01" style="border: 1px solid #E6DFD3; background-color: #F9F6F0; color: #3E322C;" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="mb-5 p-3 rounded" style="background-color: rgba(140, 115, 97, 0.05); border: 1px dashed #E6DFD3;">
                            <label class="form-label premium-font fw-bold" style="color: #8C7361;">
                                <i class="bi bi-camera me-2"></i>Update Cover Image
                            </label>
                            
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3 text-center">
                                    <img src="@Model.ImageUrl" alt="Current Image" class="img-thumbnail shadow-sm" style="max-height: 120px; border-radius: 8px; border: 1px solid #E6DFD3;" />
                                    <small class="d-block text-muted mt-1">Current Image</small>
                                </div>
                            }

                            <input type="file" name="imageFile" class="form-control px-3 py-2 shadow-none" accept="image/*" style="border: 1px solid #E6DFD3; background-color: #ffffff; color: #3E322C;" />
                            <small class="text-muted d-block mt-2" style="font-size: 0.85rem;">
                                <i class="bi bi-info-circle me-1"></i>Leave empty if you don't want to change the current image.
                            </small>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn text-white btn-lg rounded-pill fw-bold" style="background-color: #7A2836; transition: all 0.3s;">
                                Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none text-center"style="color: #8C7361;" >Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>

    .form-control:focus {
        border-color: #8C7361 !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 0.2rem rgba(140, 115, 97, 0.1) !important;
    }
    button[type="submit"]:hover {
        background-color: #5c1d28 !important; 
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(122, 40, 54, 0.2);
    }
</style>