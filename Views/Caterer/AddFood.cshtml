@model Hearty_Bites.Models.MenuItem

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden; background-color: #ffffff;">
                
                <div class="card-header bg-white py-4 text-center" style="border-bottom: 2px solid #E6DFD3;">
                    <h2 class="premium-font mb-0 fw-bold" style="color: #3E322C;">
                        <i class="bi bi-journal-plus me-2" style="color: #7A2836;"></i>Create Catering Menu
                    </h2>
                    <p class="text-muted mt-2 mb-0" style="font-size: 0.95rem;">Define your package, set a price, and categorize your concept.</p>
                </div>
                
                <div class="card-body p-5">
                    <form asp-action="AddFood" enctype="multipart/form-data" method="post">
                        
                        <div class="mb-4">
                            <label asp-for="FoodName" class="form-label premium-font fw-bold" style="color: #8C7361;">Menu / Package Title</label>
                            <input asp-for="FoodName" class="form-control rounded-pill px-3 py-2 shadow-none" placeholder="e.g., Premium Wedding Buffet" style="border: 2px solid #E6DFD3; background-color: #F9F6F0;" />
                            <span asp-validation-for="FoodName" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label premium-font fw-bold" style="color: #8C7361;">Base Price (₺)</label>
                                <input asp-for="Price" class="form-control rounded-pill px-3 py-2 shadow-none" type="number" step="0.01" style="border: 2px solid #E6DFD3; background-color: #F9F6F0;" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6 mt-3 mt-md-0">
                                <label asp-for="Category" class="form-label premium-font fw-bold" style="color: #8C7361;">Event Concept</label>
                                <select asp-for="Category" class="form-select rounded-pill px-3 py-2 shadow-none" style="border: 2px solid #E6DFD3; background-color: #F9F6F0;" required>
                                    <option value="General">General (Standard)</option>
                                    <option value="Wedding">Wedding</option>
                                    <option value="Cocktail">Cocktail</option>
                                    <option value="Birthday">Birthday</option>
                                    <option value="Corporate">Corporate</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label premium-font fw-bold" style="color: #8C7361;">Package Description</label>
                            <textarea asp-for="Description" class="form-control px-3 py-3 shadow-none" rows="6"
                            placeholder="Please list the full menu details here..." 
                            style="border: 2px solid #E6DFD3; background-color: #F9F6F0; border-radius: 15px; resize: vertical; line-height: 1.6;"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-5 p-4 rounded-4" style="background-color: #F9F6F0; border: 2px dashed #E6DFD3;">
                            <label class="form-label premium-font fw-bold mb-3 d-block text-center" style="color: #3E322C;">
                                <i class="bi bi-camera-fill me-2" style="color: #8C7361;"></i>Upload Cover Image
                            </label>
                            <input type="file" name="imageFile" class="form-control rounded-pill px-3 py-2 shadow-none bg-white" accept="image/*" />
                            <small class="text-muted d-block mt-2 text-center">High-quality photos increase bookings by 40%.</small>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn text-white btn-lg rounded-pill shadow-sm fw-bold" style="background-color: #7A2836; transition: 0.3s;">
                                Save & Continue to Options <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                            <a asp-action="Index" class="btn btn-light rounded-pill fw-bold text-muted border shadow-sm">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4 p-4 rounded-4 shadow-sm" style="background-color: #fff; border-left: 5px solid #8C7361;">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-3 me-3" style="color: #8C7361;"></i>
                    <p class="mb-0 text-muted" style="font-size: 0.95rem;">
                        <strong style="color: #3E322C;">Next Step: Customizations.</strong> After saving this menu, you will be redirected to the Customization Panel to add specific options (e.g., side choices, removable ingredients) for your customers.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>