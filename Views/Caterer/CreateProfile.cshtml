@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    string mapsApiKey = Configuration["GoogleMaps:ApiKey"] ?? "";
}

@model Hearty_Bites.Models.Caterer

@{
    ViewData["Title"] = "Create Kitchen Profile";
}

<div class="container-fluid py-5" style="background-color: #F9F6F0; min-height: 100vh;">
    <div class="container" style="max-width: 800px;">
        <div class="text-center mb-5">
            <h1 class="premium-font fw-bold" style="color: #3E322C;">Create Your Kitchen Profile</h1>
            <p class="text-muted">Fill in your details to take your place in our premium culinary community.</p>
        </div>

        <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 24px;">
            <form asp-action="CreateProfile" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-4"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="ShopName" class="form-label fw-bold" style="color: #8C7361;">Catering / Shop Name</label>
                        <input asp-for="ShopName" class="form-control rounded-pill px-3 py-2" placeholder="e.g. Mario's Gourmet" required />
                        <span asp-validation-for="ShopName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold" style="color: #8C7361;">Storefront / Logo Image</label>
                        <input type="file" name="imageFile" class="form-control rounded-pill px-3 py-2" accept="image/*" />
                        <small class="text-muted ms-2">Recommended: Square image (1:1)</small>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold" style="color: #8C7361;">About Your Kitchen</label>
                    <textarea asp-for="Description" class="form-control px-3 py-2" rows="4" style="border-radius: 15px;"
                              placeholder="Tell us about your culinary style and specialties..."></textarea>
                </div>

                <hr class="my-5 text-muted" />

                <div class="mb-4">
                    <label asp-for="Address" class="form-label premium-font fw-bold fs-5" style="color: #3E322C;">
                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>Location Details
                    </label>
                    <p class="text-muted small mb-3">Powered by Google Maps. Type your exact address and click "Verify" to pin your location so customers can find you.</p>
                    
                    <div class="d-flex gap-2 mb-3">
                        <input asp-for="Address" id="shopAddress" class="form-control rounded-pill px-3 py-2 shadow-none" 
                               placeholder="e.g., Kavaklıdere, Tunalı Hilmi Cd. No:1, Çankaya/Ankara" required style="border: 2px solid #E6DFD3;" />
                        
                        <button type="button" id="btnFindOnMap" class="btn text-white rounded-pill px-4 flex-shrink-0 shadow-sm"
                                style="background-color: #7A2836;">
                            <i class="bi bi-search me-1"></i> Verify
                        </button>
                    </div>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <input type="hidden" asp-for="Latitude" id="Latitude" />
                <input type="hidden" asp-for="Longitude" id="Longitude" />

                <div id="shopMap" class="shadow-sm mb-5"
                     style="height: 350px; border-radius: 16px; border: 3px solid #E6DFD3; z-index: 1;"></div>

                <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-5 py-3 fw-bold border shadow-sm">Cancel</a>
                    <button type="submit" class="btn text-white rounded-pill px-5 py-3 fw-bold shadow-sm" style="background-color: #3E322C;">
                        <i class="bi bi-rocket-takeoff-fill me-2"></i> Launch My Shop
                    </button>
                </div>

                <script src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey&callback=initMap&loading=async" async defer></script>
                <script>
                    let map;
                    let marker;
                    let geocoder;

                    window.initMap = function () {
                        const ankara = { lat: 39.9208, lng: 32.8541 };

                        map = new google.maps.Map(document.getElementById("shopMap"), {
                            zoom: 12,
                            center: ankara,
                            mapTypeControl: false
                        });

                        geocoder = new google.maps.Geocoder();

                        document.getElementById('btnFindOnMap').addEventListener('click', function () {
                            const address = document.getElementById('shopAddress').value;

                            if (address.length < 5) {
                                alert("Please enter a valid full address.");
                                return;
                            }

                            geocoder.geocode({ 'address': address }, function (results, status) {
                                if (status === 'OK') {
                                    const location = results[0].geometry.location;

                                    map.setCenter(location);
                                    map.setZoom(16);

                                    if (marker) {
                                        marker.setMap(null);
                                    }
                                    marker = new google.maps.Marker({
                                        map: map,
                                        position: location,
                                        animation: google.maps.Animation.DROP
                                    });

                                    document.getElementById('Latitude').value = location.lat();
                                    document.getElementById('Longitude').value = location.lng();

                                } else {
                                    alert('Location could not be found on map: ' + status);
                                }
                            });
                        });
                    };
                </script>
            </form>
        </div>
    </div>
</div>