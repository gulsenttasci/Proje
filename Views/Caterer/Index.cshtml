@model Hearty_Bites.Models.Caterer
<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid #E6DFD3;">
        <div>
            <h1 class="premium-font mb-0" style="color: #3E322C;">Shop Dashboard</h1>
            <p class="text-muted mb-0 mt-1" style="color: #8C7361 !important;">Managing menu for <strong style="color: #7A2836;">@Model.ShopName</strong></p>
        </div>
        <a asp-action="AddFood" class="btn btn-primary-custom rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Dish
        </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-white py-3" style="border-bottom: 1px solid #E6DFD3;">
            <h4 class="premium-font mb-0" style="color: #8C7361;"><i class="bi bi-card-list me-2"></i> Your Active Menu</h4>
        </div>
        
        <div class="card-body p-0">
            @if (Model.MenuItems != null && Model.MenuItems.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.MenuItems)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center py-4" style="transition: background-color 0.2s;">
                            <div class="pe-3">
                                <h5 class="fw-bold mb-1" style="color: #3E322C;">@item.FoodName</h5>
                                <small class="text-muted d-block mb-2">@item.Description</small>
                                <span class="badge" style="background-color: #F9F6F0; color: #7A2836; border: 1px solid #E6DFD3; font-family: 'Courier New', monospace; font-size: 0.9rem;">
                                    @item.Price.ToString("C")
                                </span>
                            </div>
                            
                            <div class="btn-group shadow-sm" role="group">
                                <a asp-action="EditFood" asp-route-id="@item.Id" class="btn btn-sm btn-light border" style="color: #8C7361;">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="DeleteFood" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger"
                                   onclick="return confirm('Are you sure you want to delete @item.FoodName from your menu?')">
                                    <i class="bi bi-trash3-fill"></i> Delete
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <i class="bi bi-egg-fried display-1" style="color: #E6DFD3;"></i>
                    <h5 class="mt-3 premium-font" style="color: #8C7361;">Your menu is empty</h5>
                    <p class="text-muted">Start adding delicious dishes to attract customers.</p>
                </div>
            }
        </div>
    </div>
</div>