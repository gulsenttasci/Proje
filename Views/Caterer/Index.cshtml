@model Hearty_Bites.Models.Caterer 

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    @if (Model != null)
    {
        <div class="alert alert-info shadow-sm" style="background-color: #fce4ec; border-color: #f8bbd0;">
            <h3 class="text-dark">Welcome, @Model.ShopName! 🌸</h3>
            <p class="text-muted">This is your dashboard for our authentic community, a safe space to grow and support each other.</p>
        </div>

        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">My Profile Details</h5>
                <p class="card-text"><strong>Description:</strong> @Model.Description</p>
                <p class="card-text"><strong>Address:</strong> @Model.Address</p>
                
                <hr />
                <a href="#" class="btn btn-outline-primary" style="color: #d81b60; border-color: #d81b60;">Add New Product (Coming Soon)</a>
            </div>
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <h4 class="text-muted">You haven't created your profile yet!</h4>
            <p>Start now to join our community and introduce yourself.</p>
            <a asp-controller="Caterer" asp-action="CreateProfile" class="btn btn-primary" style="background-color: #d81b60; border: none;">Create My Profile</a>
        </div>
    }
</div>