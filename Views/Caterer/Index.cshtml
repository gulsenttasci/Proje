@model Hearty_Bites.Models.Caterer 

@{
    ViewData["Title"] = "My Shop Dashboard";
}

<div class="container mt-5">
    @if (Model != null)
    {
        <div class="alert alert-info shadow-sm" style="background-color: #fce4ec; border-color: #f8bbd0;">
            <h3 class="text-dark">Welcome, @Model.ShopName! 🌸</h3>
            <p class="text-muted">This is your dashboard for our authentic community, a safe space to grow and support each other.</p>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary" style="color: #d81b60 !important;">My Profile Details</h5>
                        <p class="card-text"><strong>Description:</strong> @Model.Description</p>
                        <p class="card-text"><strong>Address:</strong> @Model.Address</p>
                        <hr />
                        <a asp-action="AddFood" class="btn text-white w-100 shadow-sm" style="background-color: #d81b60; border: none; font-weight:500;">+ Add New Product</a>
                    </div>
                </div>
            </div>

            <div class="col-md-8">

                <h4 class="mb-4 mt-4 fw-bold">My Menu 🍽️</h4>
                
                @if (Model.MenuItems == null || !Model.MenuItems.Any())
                {
                    <div class="alert alert-light border shadow-sm">
                        <p class="mb-0 text-muted">You haven't added any products yet. Click "Add New Product" to start!</p>
                    </div>
                
                }
                else
                {
                    <div class="list-group shadow-sm">
                        @foreach (var item in Model.MenuItems)
                        {
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 mb-2 shadow-sm border rounded">
                                <div>
                                    <h6 class="mb-1 fw-bold" style="color: #d81b60;">@item.FoodName</h6>
                                    <small class="text-muted">@item.Description</small>
                                </div>
                                <div class="text-end">
                                    <span class="badge rounded-pill bg-success p-2 mb-2 d-block">@item.Price</span>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="EditFood" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                                        <a asp-action="DeleteFood" asp-route-id="@item.Id" class="btn btn-outline-danger"
                                           onclick="return confirm('Are you sure you want to delete this delicious dish?')">Delete</a>

                                    </div>
                                </div>
    
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    
    else
    {
        <div class="text-center mt-5">
            <h4 class="text-muted">You haven't created your profile yet!</h4>
            <p>Start now to join our community and introduce yourself.</p>
            <a asp-controller="Caterer" asp-action="CreateProfile" class="btn btn-primary" style="background-color: #d81b60; border: none;">Create My Profile</a>
        </div>
    }
</div>

<style>
    .btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        transition: all 0.2s;
    }
</style>