@model Hearty_Bites.Models.MenuItem
@{
    ViewData["Title"] = "Manage Customizations";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid #E6DFD3;">
        <div>
            <h1 class="premium-font mb-0" style="color: #3E322C;">Customization Options</h1>
            <p class="text-muted mb-0 mt-1">Managing extras and choices for: <strong style="color: #7A2836;">@Model.FoodName</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; background-color: #F9F6F0; border: 1px solid #E6DFD3 !important;">
                <div class="card-header bg-transparent py-3" style="border-bottom: 1px solid #E6DFD3;">
                    <h5 class="fw-bold mb-0" style="color: #3E322C;"><i class="bi bi-plus-circle-fill me-2 text-success"></i> Add New Option</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddCustomizationOption" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="menuItemId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Group Name (e.g., Sauce, Size, Ingredients)</label>
                            <input type="text" name="groupName" class="form-control" placeholder="e.g., Sauce Selection" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Option Name (e.g., Ketchup, Large, No Onion)</label>
                            <input type="text" name="optionName" class="form-control" placeholder="e.g., Garlic Mayo" required />
                        </div>

                        <button type="submit" class="btn w-100 rounded-pill text-white shadow-sm fw-bold" style="background-color: #7A2836;">
                            Save Option
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white py-3" style="border-bottom: 1px solid #E6DFD3;">
                    <h5 class="fw-bold mb-0" style="color: #8C7361;"><i class="bi bi-gear-fill me-2"></i> Active Customization Groups</h5>
                </div>
                <div class="card-body p-0">
                    @if (ViewBag.CustomizationGroups != null && ((IEnumerable<dynamic>)ViewBag.CustomizationGroups).Any())
                    {
                        <div class="accordion accordion-flush" id="customizationAccordion">
                            @{ int index = 0; }
                            @foreach (var group in ViewBag.CustomizationGroups)
                            {
                                index++;
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading-@index">
                                        <button class="accordion-button collapsed fw-bold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@index" aria-expanded="false">
                                            <i class="bi bi-tags me-2 text-secondary"></i> @group.GroupName
                                        </button>
                                    </h2>
                                    <div id="collapse-@index" class="accordion-collapse collapse" data-bs-parent="#customizationAccordion">
                                        <div class="accordion-body bg-white">
                                            @if (group.Options != null && ((IEnumerable<dynamic>)group.Options).Any())
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var opt in group.Options)
                                                    {
                                                        <span class="badge px-3 py-2 rounded-pill shadow-sm text-dark" style="background-color: #F9F6F0; border: 1px solid #E6DFD3; font-size: 0.85rem;">
                                                            <i class="bi bi-check2 text-success me-1"></i> @opt.OptionName
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No options added to this group yet.</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-sliders display-4 d-block mb-3 text-muted" style="opacity: 0.4;"></i>
                            <span>No customizations defined yet. Use the form on the left to add items.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>