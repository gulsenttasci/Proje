@{
    ViewData["Title"] = "Caterer Dashboard";
}

<div class="container-fluid py-5" style="background-color: #F9F6F0; min-height: 100vh;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="premium-font fw-bold" style="color: #3E322C;">Master Dashboard</h1>
                <p class="text-muted">Welcome back, @ViewBag.ShopName. Here is your kitchen's performance today.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-dark rounded-pill px-4">Edit Profile</button>
                <button class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #7A2836;">+ Add New Dish</button>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 20px; border-left: 5px solid #7A2836 !important;">
                    <small class="text-uppercase fw-bold text-muted mb-2 d-block">Total Revenue</small>
                    <h2 class="fw-bold" style="color: #3E322C;">@ViewBag.TotalRevenue</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 20px;">
                    <small class="text-uppercase fw-bold text-muted mb-2 d-block">Active Dishes</small>
                    <h2 class="fw-bold" style="color: #3E322C;">@ViewBag.ActiveDishes</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 20px;">
                    <small class="text-uppercase fw-bold text-muted mb-2 d-block">Avg. Rating</small>
                    <h2 class="fw-bold" style="color: #7A2836;">@ViewBag.AverageRating <i class="bi bi-star-fill small"></i></h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 20px; background-color: #3E322C;">
                    <small class="text-uppercase fw-bold text-white-50 mb-2 d-block">Incoming Orders</small>
                    <h2 class="fw-bold text-white">@ViewBag.IncomingOrders</h2>
                </div>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 24px;">
                    <h4 class="fw-bold mb-4" style="color: #3E322C;">Storefront Media</h4>
                    
                    <div class="text-center mb-4">
                        <div class="mx-auto shadow-sm mb-3 d-flex align-items-center justify-content-center" 
                             style="width: 180px; height: 180px; border-radius: 20px; border: 2px dashed #8C7361; background-color: #f8f9fa; overflow: hidden;">
                            <i class="bi bi-camera-fill text-muted" style="font-size: 3rem;"></i>
                            </div>
                        <button class="btn btn-sm btn-dark rounded-pill px-4">Upload Photo</button>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <label class="small fw-bold text-muted">Catering Name</label>
                        <p class="mb-0 fw-bold">@ViewBag.ShopName</p>
                    </div>
                    <div class="mb-0">
                        <label class="small fw-bold text-muted">Business Address</label>
                        <p class="mb-0">@ViewBag.ShopAddress</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4" style="border-radius: 24px;">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0" style="color: #3E322C;">Active Menu Packages</h4>
                        <a href="#" class="small text-decoration-none" style="color: #7A2836;">View All Menus</a>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="text-muted small">
                                <tr>
                                    <th>Menu Name</th>
                                    <th>Base Price</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-3 me-3" style="width: 50px; height: 50px;"></div>
                                            <span class="fw-bold">Truffle Pasta Package</span>
                                        </div>
                                    </td>
                                    <td>₺450.00</td>
                                    <td><span class="badge rounded-pill bg-success-subtle text-success px-3">Live</span></td>
                                    <td class="text-end">
                                        <button class="btn btn-light btn-sm rounded-circle"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-light btn-sm rounded-circle text-danger"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-3 me-3" style="width: 50px; height: 50px;"></div>
                                            <span class="fw-bold">Grilled Salmon Deluxe</span>
                                        </div>
                                    </td>
                                    <td>₺620.00</td>
                                    <td><span class="badge rounded-pill bg-success-subtle text-success px-3">Live</span></td>
                                    <td class="text-end">
                                        <button class="btn btn-light btn-sm rounded-circle"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-light btn-sm rounded-circle text-danger"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>