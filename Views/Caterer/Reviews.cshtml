@model IEnumerable<Hearty_Bites.Models.Comments>
@{
    ViewData["Title"] = "Customer Reviews";
}
<div class="container-fluid py-5" style="background-color: #F9F6F0; min-height: 100vh;">
    <div class="container" style="max-width: 900px;">

        <div class="d-flex justify-content-between align-items-center mb-5 pb-3"
             style="border-bottom: 2px solid #E6DFD3;">
            <div>
                <h1 class="premium-font fw-bold" style="color: #3E322C;">Customer Reviews</h1>
                <p class="text-muted mb-0 mt-1" style="color: #8C7361 !important;">
                    Feedback and ratings from your kitchen's valued customers.
                </p>
            </div>
            <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center p-5 card border-0 shadow-sm" style="border-radius: 24px; background-color: #fff;">
                <i class="bi bi-chat-square-heart display-1" style="color: #E6DFD3;"></i>
                <h5 class="mt-4 premium-font fw-bold" style="color: #8C7361;">No reviews received yet</h5>
                <p class="text-muted">Once customers start tasting your food, their feedback will appear here.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var rev in Model)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm p-4" style="border-radius: 20px; background-color: #fff;">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-bold mb-1" style="color: #3E322C;">
                                        <i class="bi bi-person-circle me-2 text-muted"></i>@rev.User?.Email
                                    </h6>
                                    <small class="text-muted">@rev.CreatedDate.ToString("MMM dd, yyyy - HH:mm")</small>
                                </div>

                                <div class="fs-5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= rev.StarRating)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star" style="color: #E6DFD3;"></i>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="p-3 mt-2"
                                 style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #8C7361;">
                                <p class="mb-0" style="color: #5a4b42; font-size: 1.05rem; font-style: italic;">
                                    "@rev.CommentText"
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>