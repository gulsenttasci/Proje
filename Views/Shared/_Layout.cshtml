<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hearty Bites</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3" style="background-color: #F9F6F0; border-color: #E6DFD3 !important;">
        <div class="container-fluid">
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="btn border-0 me-2 shadow-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" title="Menu" style="padding: 0 4px;">
                    <i class="bi bi-list" style="font-size: 1.8rem; color: #7A2836;"></i>
                </button>
            }

            <a class="navbar-brand fw-bold premium-font" asp-area="" asp-controller="Home" asp-action="Index" style="color: #7A2836; font-size: 1.5rem;">
                Hearty Bites Catering
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" style="color: #3E322C;">Home</a>
                    </li>
                </ul>

                <ul class="navbar-nav align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link fw-bold" style="color: #8C7361;"><i class="bi bi-person-circle me-1"></i> Welcome, @User.Identity.Name!</span>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                             <a class="nav-link" asp-controller="Account" asp-action="Login" style="color: #3E322C;">Login</a>
                        </li>
                        <li class="nav-item ms-2">
                             <a class="nav-link text-white px-3" asp-controller="Account" asp-action="Register" style="background-color: #7A2836; border-radius: 20px;">Sign Up</a>
                        </li> 
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="offcanvas offcanvas-start shadow-lg border-0" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel" style="background-color: #F9F6F0; width: 300px;">
        
        <div class="offcanvas-header border-bottom py-4" style="border-color: #E6DFD3 !important; background-color: #fff;">
            <h5 class="offcanvas-title premium-font fw-bold d-flex align-items-center" id="sidebarMenuLabel" style="color: #3E322C;">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white me-3" style="width: 40px; height: 40px; background-color: #8C7361;">
                    <i class="bi bi-grid-fill"></i>
                </div>
                Dashboard
            </h5>
            <button type="button" class="btn-close text-reset shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        
        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush mt-2">
                
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="list-group-item list-group-item-action py-3 px-4 fw-bold d-flex align-items-center" style="background-color: transparent; color: #7A2836; border-color: #E6DFD3;">
                        <i class="bi bi-shield-lock-fill me-3" style="font-size: 1.3rem;"></i> Admin Panel
                    </a>
                }

                @if (User.IsInRole("Caterer"))
                {
                    <a asp-controller="Caterer" asp-action="Index" class="list-group-item list-group-item-action py-3 px-4 fw-bold d-flex align-items-center" style="background-color: transparent; color: #3E322C; border-color: #E6DFD3;">
                        <i class="bi bi-shop-window me-3 text-muted" style="font-size: 1.3rem;"></i> Manage Shop
                    </a>
                }
                
                <a asp-area="" asp-controller="Customer" asp-action="Index" class="list-group-item list-group-item-action py-3 px-4 fw-bold d-flex align-items-center" style="background-color: transparent; color: #3E322C; border-color: #E6DFD3;">
                    <i class="bi bi-shop me-3 text-muted" style="font-size: 1.3rem;"></i> Browse Caterers
                </a>
                
                <a asp-area="" asp-controller="Customer" asp-action="MyOrders" class="list-group-item list-group-item-action py-3 px-4 fw-bold d-flex align-items-center" style="background-color: transparent; color: #3E322C; border-color: #E6DFD3;">
                    <i class="bi bi-receipt me-3 text-muted" style="font-size: 1.3rem;"></i> My Orders
                </a>
                
                <a asp-area="" asp-controller="Cart" asp-action="Index" class="list-group-item list-group-item-action py-3 px-4 fw-bold d-flex align-items-center" style="background-color: transparent; color: #3E322C; border-color: #E6DFD3;">
                    <i class="bi bi-cart3 me-3 text-muted" style="font-size: 1.3rem;"></i> My Cart
                </a>

            </div>
        </div>
        
        <div class="offcanvas-footer p-4 border-top" style="border-color: #E6DFD3 !important; background-color: #fff;">
            <a asp-controller="Account" asp-action="Logout" class="btn w-100 text-white rounded-pill fw-bold shadow-sm py-2" style="background-color: #7A2836;">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </div>
        
    </div>
}

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 - <strong>Hearty Bites</strong> | With pleasure.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
