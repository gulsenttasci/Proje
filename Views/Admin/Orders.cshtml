@model IEnumerable<Hearty_Bites.Models.Order>
@{
    ViewData["Title"] = "Admin - All Orders";
}

<div class="container mt-4 mb-5">
    
    <div class="card bg-dark text-white p-3 mb-4 border-0 shadow-sm" style="border-radius: 12px;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-shield-shaded text-danger me-2"></i>Admin Core Center</h4>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="btn btn-sm btn-danger rounded-pill px-3 fw-bold" asp-action="Orders"><i class="bi bi-bag-check"></i> Orders</a>
                <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-action="ManageMenus"><i class="bi bi-card-list"></i> Menus</a>
                <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-action="ManageComments"><i class="bi bi-chat-left-text"></i> Comments</a>
                <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-action="Logs"><i class="bi bi-terminal"></i> Logs</a>
            </div>
        </div>
    </div>

    <h3 class="mb-4 fw-bold text-secondary"><i class="bi bi-currency-exchange"></i> Platform Orders</h3>

    <div class="card border-0 shadow-sm rounded overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>User ID</th>
                        <th>Order Date</th>
                        <th>Event Date</th>
                        <th>Total Amount</th>
                        <th>Delivery Address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td class="text-muted text-truncate" style="max-width: 120px;">@order.UserId</td>
                            <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@order.EventDate.ToString("dd.MM.yyyy")</td>
                            <td class="text-success fw-bold">@order.TotalAmount.ToString("N2") ₺</td>
                            <td class="text-truncate" style="max-width: 250px;">@order.DeliveryAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Orders navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link border-secondary bg-dark text-white" asp-action="Orders" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)">&laquo; Prev</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link @(ViewBag.CurrentPage == i ? "bg-secondary border-secondary text-white" : "bg-dark border-secondary text-white")" asp-action="Orders" asp-route-pageNumber="@i">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.HasNextPage ? "" : "disabled")">
                    <a class="page-link border-secondary bg-dark text-white" asp-action="Orders" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)">Next &raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>