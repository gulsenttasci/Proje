@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-shield-lock-fill text-danger"></i> Admin Control Center</h2>
    </div>

    <div class="card bg-dark text-white p-3 mb-5 border-0 shadow-sm" style="border-radius: 12px;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-shield-shaded text-danger me-2"></i>Admin Navigation</h4>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-light text-dark fw-bold rounded-pill px-3" asp-action="Dashboard"><i
                    class="bi bi-speedometer2"></i> Dashboard</a>
                    <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-action="Orders"><i
                        class="bi bi-bag-check"></i> Orders</a>
                        <a class="btn btn-sm btn-outline-warning rounded-pill px-3" asp-action="ManageMenus"><i
                            class="bi bi-card-list"></i> Menus</a>
                            <a class="btn btn-sm btn-outline-info rounded-pill px-3" asp-action="ManageComments"><i
                                class="bi bi-chat-left-text"></i> Comments</a>
                                <a class="btn btn-sm btn-outline-success rounded-pill px-3" asp-action="Logs"><i
                                    class="bi bi-terminal"></i> Logs</a>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-3">
                                <div class="card bg-primary text-white shadow-sm border-0 h-100">
                                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-uppercase small mb-1" style="opacity: 0.8;">Total Caterers</h6>
                                            <h3 class="fw-bold mb-0">@ViewBag.TotalShops</h3>
                                        </div>
                                        <i class="bi bi-shop display-6" style="opacity: 0.4;"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-success text-white shadow-sm border-0 h-100">
                                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-uppercase small mb-1" style="opacity: 0.8;">Total Menu Items</h6>
                                            <h3 class="fw-bold mb-0">@ViewBag.TotalFoods</h3>
                                        </div>
                                        <i class="bi bi-egg-fried display-6" style="opacity: 0.4;"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-dark shadow-sm border-0 h-100">
                                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-uppercase small mb-1" style="opacity: 0.8;">Total Orders</h6>
                                            <h3 class="fw-bold mb-0">@ViewBag.TotalOrders</h3>
                                        </div>
                                        <i class="bi bi-bag-check display-6" style="opacity: 0.4;"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-dark shadow-sm border-0 h-100">
                                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-uppercase small mb-1" style="opacity: 0.8;">System Logs</h6>
                                            <h3 class="fw-bold mb-0">@ViewBag.TotalLogs</h3>
                                        </div>
                                        <i class="bi bi-terminal display-6" style="opacity: 0.4;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h4 class="mb-3 fw-bold text-secondary mt-5"><i class="bi bi-table"></i> Recent Activities (Top 5 Preview)</h4>
                        <div class="row g-4">
                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 mb-4">
                                    <div class="card-header bg-dark text-white fw-bold py-3">
                                        <i class="bi bi-people-fill me-2 text-info"></i> Registered Caterers
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Caterer Name</th>
                                                    <th>Address</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (ViewBag.AllCaterers != null)
                                                {
                                                    foreach (var caterer in (IEnumerable<Hearty_Bites.Models.Caterer>)ViewBag.AllCaterers)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">#@caterer.Id</td>
                                                            <td>@caterer.ShopName</td>
                                                            <td class="text-muted text-truncate" style="max-width: 200px;">@caterer.Address</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 mb-4">
                                    <div class="card-header bg-dark text-white fw-bold py-3">
                                        <i class="bi bi-egg-fried me-2 text-warning"></i> Recent Menus
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Menu Name</th>
                                                    <th>Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (ViewBag.AllMenuItems != null)
                                                {
                                                    foreach (var item in (IEnumerable<Hearty_Bites.Models.MenuItem>)ViewBag.AllMenuItems)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">#@item.Id</td>
                                                            <td>@item.FoodName</td>
                                                            <td class="text-success fw-bold">@item.Price.ToString("N2") ₺</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm border-0 mt-5">
                        <div class="card-header bg-dark text-white fw-bold py-3">
                            <i class="bi bi-chat-square-quote-fill text-warning me-2"></i> Recent Platform Reviews & Ratings
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>User Email</th>
                                            <th>Target Menu</th>
                                            <th>Rating</th>
                                            <th>Review Text</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ViewBag.AllComments != null)
                                        {
                                            foreach (var com in (IEnumerable<Hearty_Bites.Models.Comments>)ViewBag.AllComments)
                                            {
                                                <tr>
                                                    <td class="small">@com.CreatedDate.ToString("yyyy-MM-dd")</td>
                                                    <td class="fw-bold text-muted">@com.User?.Email</td>
                                                    <td><span class="badge bg-secondary">@com.Caterer?.ShopName</span></td>
                                                    <td>
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="bi bi-star-fill @(i <= com.StarRating ? "text-warning" : "text-muted")"></i>
                                                        }
                                                    </td>
                                                    <td class="text-dark">"@com.CommentText"</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>